#!/usr/bin/env bash
#
# pre-commit — architecture drift guard + mechanical guardrails
#
# Fails the commit if it adds/removes a crate or widens/narrows `common`'s
# public surface without a matching change under architecture/. Both are
# mechanical, cheap-to-detect proxies for "this needs a human architecture
# decision" — a new dependency EDGE on an existing crate is caught
# unconditionally by check-dep-table.py below instead, so it is not
# re-checked here. This deliberately does NOT fire on every commit that
# touches crates/ — an earlier version did, and in practice that trained
# `SKIP_ARCH_CHECK=1` as a reflex rather than a considered exception.
#
# Also runs two mechanical lints (scripts/check-dep-table.py,
# scripts/check-tracing-targets.py) against the working tree whenever the
# commit has any staged files. These enforce the components.md dependency
# table and the tracing target: convention respectively — see
# architecture/cross-cutting.md. They run unconditionally (independent of the
# architecture-drift outcome below, including under SKIP_ARCH_CHECK) because
# they check working-tree state, not the drift-guard's staged/doc-touch
# heuristic.
#
# Install once per clone:
#     git config core.hooksPath .githooks
#
# Override the architecture drift check only (rarely justified; the
# guardrail lints below are not affected):
#     SKIP_ARCH_CHECK=1 git commit ...

set -euo pipefail

# Staged-paths-only; we do not look at unstaged or untracked changes.
staged="$(git diff --cached --name-only --diff-filter=ACMRTD)"

if [ -z "$staged" ]; then
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"

echo "[pre-commit] running guardrails: dependency-table + tracing-target checks" >&2
uv run "$repo_root/scripts/check-dep-table.py"
uv run "$repo_root/scripts/check-tracing-targets.py"

if [ "${SKIP_ARCH_CHECK:-0}" = "1" ]; then
    echo "[pre-commit] SKIP_ARCH_CHECK=1 — architecture drift check bypassed" >&2
    exit 0
fi

# Mechanical signals for "this needs an architecture-doc decision":
#   1. A crate was added or removed (a Cargo.toml appeared or disappeared
#      under crates/ or src-tauri/).
#   2. `common`'s public surface changed (a `pub ` line was added or
#      removed in crates/common/src/lib.rs) — the one crate every other
#      crate can see, so a widened/narrowed surface there is workspace-wide.
arch_signal=0
while IFS= read -r path; do
    case "$path" in
        crates/*/Cargo.toml|src-tauri/Cargo.toml)
            arch_signal=1
            ;;
    esac
done <<< "$(git diff --cached --name-only --diff-filter=AD)"

if git diff --cached -- crates/common/src/lib.rs | grep -qE '^[+-]pub '; then
    arch_signal=1
fi

if [ "$arch_signal" = "0" ]; then
    exit 0
fi

# Did the commit also touch the architecture docs?
arch_changed=0
while IFS= read -r path; do
    case "$path" in
        architecture/*)
            arch_changed=1
            ;;
    esac
done <<< "$staged"

if [ "$arch_changed" = "1" ]; then
    exit 0
fi

cat >&2 <<EOF
[pre-commit] architecture drift check FAILED

  This commit adds/removes a crate, or changes common's public surface,
  but no file under architecture/ is staged.

  The architecture docs are LIVE — they describe the code as it is in the
  current commit. Update the relevant file:

    architecture/system-context.md
    architecture/containers.md
    architecture/components.md
    architecture/domain-ownership.md
    architecture/workspace.dsl   (then re-run scripts/render-architecture.sh)

  If this trigger is a false positive (e.g. common's pub surface changed
  but nothing externally consumer-visible actually moved), set
  SKIP_ARCH_CHECK=1 on this commit and explain in the commit message.

  Bypass:  SKIP_ARCH_CHECK=1 git commit ...
EOF
exit 1
