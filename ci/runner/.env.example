# Copy to .env (git-ignored). RUNNER_TOKEN is a ONE-TIME registration token,
# only consumed on the very first start (or after removing the runner on
# GitHub); registration persists in the state volume afterwards.
#
#   gh api -X POST repos/Minutist/minutist/actions/runners/registration-token --jq .token
#
REPO_URL=https://github.com/Minutist/minutist
RUNNER_TOKEN=
RUNNER_NAME=telie-bulk
RUNNER_LABELS=self-hosted,linux,x64,bulk

# Where the runner state + toolcache live (host == container path; see the
# docker-compose same-path rule). Defaults to /mnt/bulk/srv/github-runner. On a
# host with fast LOCAL storage, point this at local SSD instead of a NAS mount —
# the runner's cargo target/ and _work dominate build time. When set, `mkdir -p
# $RUNNER_STATE_BASE/{state,toolcache}` owned by uid 1000 before `up`. Run
# `docker compose` from this dir so it is auto-loaded for interpolation.
# RUNNER_STATE_BASE=/srv/github-runner
