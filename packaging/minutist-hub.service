# systemd unit for the Minutist headless sync hub.
#
# Install (as root):
#   useradd --system --no-create-home --shell /usr/sbin/nologin minutist-hub
#   install -m 0755 minutist-hub            /usr/local/bin/minutist-hub
#   install -m 0644 minutist-hub.service    /etc/systemd/system/minutist-hub.service
#   install -d -m 0700                       /etc/minutist-hub
#   printf 'MINUTIST_SYNC_TOKEN=%s\n' "<relay token>" > /etc/minutist-hub/minutist-hub.env
#   chmod 0600 /etc/minutist-hub/minutist-hub.env
#   systemctl daemon-reload && systemctl enable --now minutist-hub
#
# Sign in (the ONLY way the hub discovers peers), then restart. `login` must
# run AS the fixed `minutist-hub` user so tunnel_device.json lands owned by
# the same user the running service reads it as (StateDirectory is only
# created/chowned once the service has started at least once):
#   sudo -u minutist-hub minutist-hub --data-dir /var/lib/minutist-hub login
#   systemctl restart minutist-hub
# (the daemon reads the credential once at startup, so a restart is required
# after signing in.)

[Unit]
Description=Minutist headless device-sync hub
Documentation=https://github.com/Minutist/minutist
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A fixed, unprivileged system user (not DynamicUser: a one-shot `login`
# invocation runs outside the unit, as this same fixed user via `sudo -u`, so
# the credential it writes is always readable by the running service --
# DynamicUser's per-activation UID makes that alignment unreliable across an
# out-of-unit CLI invocation). StateDirectory creates and owns
# /var/lib/minutist-hub (the daemon's data root: device key, account
# credential, meetings, logs) the first time the unit starts. %S expands to
# /var/lib.
User=minutist-hub
Group=minutist-hub
StateDirectory=minutist-hub
# The relay access token (MINUTIST_SYNC_TOKEN=...). Optional ('-' = no error if
# absent) so the unit loads before the operator drops the token in.
EnvironmentFile=-/etc/minutist-hub/minutist-hub.env
ExecStart=/usr/local/bin/minutist-hub --data-dir %S/minutist-hub
# systemd sends SIGTERM on stop; the daemon drains within its bounded grace
# window (< the default 90s TimeoutStopSec) and exits 0.
Restart=on-failure
RestartSec=5

# Hardening: the daemon needs only its StateDirectory and outbound network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target
