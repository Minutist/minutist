<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Minutist on macOS.

  Microphone access: the AVFoundation audio capture stack requires
  NSMicrophoneUsageDescription (Info.plist) to prompt the user; the
  hardened runtime also requires the com.apple.security.device.audio-input
  entitlement or the capture API returns a "no hardware" error.

  No JIT entitlements: GGML/llama.cpp is AOT-compiled (CPU SIMD
  intrinsics; the Metal backend compiles shaders through the Metal
  framework out-of-process), and WKWebView's JIT runs in Apple's separate
  WebContent process with its own entitlements — the host app allocates
  no executable memory at runtime.
-->
<plist version="1.0">
<dict>
  <!-- Microphone capture (cpal + AVFoundation). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
