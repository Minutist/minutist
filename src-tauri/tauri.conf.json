{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meeting-app",
  "version": "0.0.0",
  "identifier": "net.alelec.meeting-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "meeting-app",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "decorations": true,
        "closable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/16x16.png"
    ]
  }
}
