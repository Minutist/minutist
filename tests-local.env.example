# Local integration-test configuration — copy to `tests-local.env` and adjust.
#
#   cp tests-local.env.example tests-local.env   # then edit paths if needed
#   make test-integration                        # runs the model-gated tests
#
# `make test-integration` sources this file and runs the #[ignore]/env-gated
# integration tests DIRECTLY against real models + recordings — the suite that
# catches model-integration bugs (e.g. a chat template the bundled llama.cpp
# cannot render) without a full Windows rebuild + manual click-through.
#
# `tests-local.env` is machine-specific and git-excluded (.git/info/exclude).
# On this WSL box the models + recordings live under the Windows app-data dir,
# reachable via /mnt/c — adjust to wherever yours are.

# --- ASR: Qwen3-ASR mtmd (the GGUF + its mmproj) -------------------------
MEETING_APP_ASR_MODEL_PATH=/mnt/c/Users/anl/AppData/Roaming/net.alelec.meeting-app/models/asr/qwen3-asr-0.6b-q8_0/Qwen3-ASR-0.6B-Q8_0.gguf
MEETING_APP_ASR_MMPROJ_PATH=/mnt/c/Users/anl/AppData/Roaming/net.alelec.meeting-app/models/asr/qwen3-asr-0.6b-q8_0/mmproj-Qwen3-ASR-0.6B-Q8_0.gguf

# --- Summariser LLM: Gemma 4 E4B -----------------------------------------
MEETING_APP_LLM_MODEL_PATH=/mnt/c/Users/anl/AppData/Roaming/net.alelec.meeting-app/models/llm/gemma-4-e4b-it-q4_k_m/gemma-4-E4B-it-Q4_K_M.gguf

# --- Diarization: pyannote segmentation + 3D-Speaker CAM++ embedding -----
MEETING_APP_DIARIZE_SEG_PATH=/mnt/c/Users/anl/AppData/Roaming/net.alelec.meeting-app/models/diarize/pyannote-segmentation-3-0/model.onnx
MEETING_APP_DIARIZE_EMB_PATH=/mnt/c/Users/anl/AppData/Roaming/net.alelec.meeting-app/models/diarize/3dspeaker-campplus-zh-en-advanced/3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx

# --- Silero VAD (committed in-repo; absolute so any cwd resolves it) ------
MEETING_APP_SILERO_PATH=/home/anl/meeting-app/resources/silero/silero_vad_v4.onnx

# --- Real recordings (meeting folders: transcript.json + audio.opus) -----
MEETING_APP_RECORDINGS_DIR=/mnt/c/Users/anl/AppData/Roaming/net.alelec.meeting-app/meetings
