# Local integration-test configuration — copy to `tests-local.env` and adjust.
#
#   cp tests-local.env.example tests-local.env   # then edit paths if needed
#   make test-integration                        # runs the model-gated tests
#
# `make test-integration` sources this file and runs the #[ignore]/env-gated
# integration tests DIRECTLY against real models + recordings — the suite that
# catches model-integration bugs (e.g. a chat template the bundled llama.cpp
# cannot render) without a full app rebuild + manual click-through.
#
# `tests-local.env` is machine-specific and git-excluded (.git/info/exclude).
# Point the paths at wherever your app-data root lives. The model layout under
# it is models/<kind>/<model-id>/<file> as produced by the in-app downloader
# (kinds: asr / llm / diarize). Two common roots:
#   - Linux:   $XDG_DATA_HOME/ai.minutist or ~/.local/share/ai.minutist
#   - Windows via WSL: /mnt/c/Users/<you>/AppData/Roaming/ai.minutist

# The app-data root all model paths below derive from.
MINUTIST_DATA_ROOT=$HOME/.local/share/ai.minutist

# --- ASR: Qwen3-ASR mtmd (the GGUF + its mmproj) -------------------------
MINUTIST_ASR_MODEL_PATH=$MINUTIST_DATA_ROOT/models/asr/qwen3-asr-0.6b-q8_0/Qwen3-ASR-0.6B-Q8_0.gguf
MINUTIST_ASR_MMPROJ_PATH=$MINUTIST_DATA_ROOT/models/asr/qwen3-asr-0.6b-q8_0/mmproj-Qwen3-ASR-0.6B-Q8_0.gguf

# --- ASR: Parakeet TDT v3 (sherpa-onnx transducer dir) --------------------
MINUTIST_PARAKEET_DIR=$MINUTIST_DATA_ROOT/models/asr/parakeet-tdt-0.6b-v3-int8

# --- Summariser LLM: Gemma 4 E4B -----------------------------------------
MINUTIST_LLM_MODEL_PATH=$MINUTIST_DATA_ROOT/models/llm/gemma-4-e4b-it-q4_k_m/gemma-4-E4B-it-Q4_K_M.gguf

# --- Diarization: pyannote segmentation + 3D-Speaker CAM++ embedding -----
MINUTIST_DIARIZE_SEG_PATH=$MINUTIST_DATA_ROOT/models/diarize/pyannote-segmentation-3-0/model.onnx
MINUTIST_DIARIZE_EMB_PATH=$MINUTIST_DATA_ROOT/models/diarize/3dspeaker-campplus-zh-en-advanced/3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx

# --- Silero VAD (committed in-repo; absolute so any cwd resolves it) ------
MINUTIST_SILERO_PATH=/absolute/path/to/repo/resources/silero/silero_vad_v4.onnx

# --- Real recordings (meeting folders: transcript.json + audio.opus) -----
MINUTIST_RECORDINGS_DIR=$MINUTIST_DATA_ROOT/meetings
